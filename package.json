{
  "name": "findy-hackathon-app",
  "type": "module",
  "scripts": {
    "setup:skills": "node scripts/setup-skills.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "agents": "^0.30.0",
    "hono": "^4.13.13",
    "hono-agents": "^3.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vite-ssr-components": "^0.9.0",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@10.33.4",
  "overrides": {
    "agents": {
      "@modelcontextprotocol/sdk": "1.32.1",
      "@modelcontextprotocol/client": "2.3.1",
      "@modelcontextprotocol/server": "2.3.1",
      "zod": "4.6.7"
    },
    "miniflare": {
      "undici": "7.30.1"
    },
    "body-parser": "2.4.0"
  }
}
