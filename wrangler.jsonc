{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findy-campus-hackathon-02",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RadioAgent",
        "class_name": "RadioAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RadioAgent"]
    }
  ]
}
