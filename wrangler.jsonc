{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findy-campus-hackathon-02",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OtayoriAgent",
        "class_name": "OtayoriAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CounterAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RadioAgent"],
      "deleted_classes": ["CounterAgent"]
    },
    {
      "tag": "v3",
      "renamed_classes": [{ "from": "RadioAgent", "to": "OtayoriAgent" }]
    }
  ]
}
