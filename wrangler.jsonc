{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findy-campus-hackathon-02",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otayori",
      "database_id": "b738b0fe-10c9-42ad-8d41-1956a234a836"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OtayoriAgent",
        "class_name": "OtayoriAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CounterAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RadioAgent"],
      "deleted_classes": ["CounterAgent"]
    },
    {
      "tag": "v3",
      "renamed_classes": [{ "from": "RadioAgent", "to": "OtayoriAgent" }]
    }
  ]
}
